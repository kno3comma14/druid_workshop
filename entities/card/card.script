function init(self)
	-- Cache the reference to the nested GUI component
	self.gui_url = msg.url("#card_template")

	-- Keep track of whether the card data is populated
	self.card_data = nil
end

function update(self, dt)
	-- 1. Grab the physical world position of this Game Object (e.g., set by the factory)
	local world_pos = go.get_position()

	-- 2. Translate world space (Game Object) into screen space (GUI pixels)
	-- If you use a custom camera system like 'Rendercam', swap this out for:
	-- local screen_pos = rendercam.world_to_screen(world_pos)
	local screen_pos = world_pos 

	-- 3. Push the calculated screen position directly down to the GUI's root node
	-- This forces the template to follow the Game Object precisely without breaking text or shaders
	msg.post(self.gui_url, "update_position", { position = screen_pos })
end

function on_message(self, message_id, message, sender)
	if message_id == hash("init_card_data") then
		self.card_data = message
		msg.post("#card_template", "populate_gui", message)
	end
end