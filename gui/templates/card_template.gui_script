local druid = require("druid.druid")

function init(self)
	self.root_node = gui.get_node("root")
end

function final(self)
	if self.druid then
		self.druid:final()	
	end
	
end

function update(self, dt)
	
end

function on_message(self, message_id, message, sender)
	if message_id == hash("update_position") then
		gui.set_position(self.root_node, message.position)
	end

	if message_id == hash("populate_gui") then
		gui.set_text(gui.get_node("title"), message.title)
		gui.set_text(gui.get_node("sanity_cost"), tostring(message.sanity_cost))
		-- gui.play_flipbook(gui.get_node("illustration_node"), message.art)
	end
end

-- function on_message(self, message_id, message, sender)
-- 	self.druid:on_message(message_id, message, sender)
-- end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end